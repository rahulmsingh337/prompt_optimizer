# ─────────────────────────────────────────────────────────────────────────────
# Prompify Environment Variables
# Copy to .env and fill in. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# --- AI Keys ---
# Primary Gemini key. Required.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional additional keys for rotation under quota pressure
# GEMINI_API_KEY_2="MY_SECOND_GEMINI_KEY"
# GEMINI_API_KEY_3="MY_THIRD_GEMINI_KEY"

# Groq API key (optional, used as primary fast LLM, falls back to Gemini)
# GROQ_API_KEY="gsk_..."

# --- App Config ---
APP_URL="http://localhost:3000"
AUTH_SECRET="SOMERANDOMSECRETSTRING32CHARS"

# --- Google OAuth (for Sign in with Google via Firebase) ---
AUTH_GITHUB_ID="YOUR_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# --- Owner ---
# Your Google account email. Only this exact email gets unlimited tokens.
# No more @google.com wildcard — security fix.
OWNER_EMAIL="your_email@gmail.com"

# --- Firebase Admin (NEW — for persistent token limits & shared prompts) ---
#
# Option A (Recommended for Vercel): paste your Firebase service account JSON
# as a single-line string. Get it from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Stringify it: JSON.stringify(require('./path/to/serviceAccountKey.json'))
#
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com",...}'
#
# Option B (Local dev / Cloud Run): use application default credentials.
# Run: gcloud auth application-default login
# Then leave FIREBASE_SERVICE_ACCOUNT_JSON unset — admin SDK auto-detects.
#
# If neither is set, token tracking falls back to daily_tokens.json (local dev only).
# Shared prompts will use in-memory storage (lost on restart) without this var.

# --- Optional ---
# HEALTH_SECRET="some_secret_token_for_health_endpoint"
